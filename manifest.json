{
  "manifest_version": 3,
  "name": "Passo a Passo — Tutorial em PDF",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Transforme seus cliques em um tutorial com prints, marcações vermelhas e PDF. Tudo processado localmente.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "scripting", "storage", "unlimitedStorage", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Passo a Passo", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}],
  "commands": {
    "toggle-pause": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pausar ou continuar tutorial"},
    "finish": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Finalizar tutorial"}
  },
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'"}
}
